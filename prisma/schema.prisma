// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RecoveryPlanStatus {
  ACTIVE
  COMPLETED
  PAUSED
}

enum MeasurementType {
  FLEXION_DEGREES
  EXTENSION_DEGREES
  QUAD_CIRCUMFERENCE_CM
  WEIGHT_KG
  WAIST_CM
  HIP_CM
  NECK_CM
  OTHER
}

enum AppointmentType {
  THERAPY
  MEDICAL
}

enum ExerciseMetricType {
  REPS
  DURATION
}

model RecoveryPlan {
  id          String             @id @default(uuid())
  userId      String
  bodyPart    String
  injuryType  String
  surgeryDate DateTime
  status      RecoveryPlanStatus @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  exercises      Exercise[]
  appointments   Appointment[]
  measurements   Measurement[]
  progressPhotos     ProgressPhoto[]
  painLogs           PainLog[]
  adHocProtocolDays  AdHocProtocolDay[]

  @@index([userId])
}

model AdHocProtocolDay {
  id             String       @id @default(uuid())
  recoveryPlanId String
  recoveryPlan   RecoveryPlan @relation(fields: [recoveryPlanId], references: [id])
  targetDate     DateTime     @db.Date
  sourceDate     DateTime     @db.Date
  createdAt      DateTime     @default(now())

  @@unique([recoveryPlanId, targetDate])
}

model Exercise {
  id                    String             @id @default(uuid())
  recoveryPlanId        String
  recoveryPlan          RecoveryPlan       @relation(fields: [recoveryPlanId], references: [id])
  name                  String
  metricType            ExerciseMetricType @default(REPS)
  targetSets            Int
  targetReps            Int
  targetDurationMinutes Int?
  referenceMediaUrl     String?
  notes                 String?
  daysOfWeek            Int[]              @default([])
  createdAt             DateTime           @default(now())

  logs        ExerciseLog[]
  completions ExerciseCompletion[]
}

model ExerciseCompletion {
  id         String   @id @default(uuid())
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  date       DateTime @db.Date
  createdAt  DateTime @default(now())

  @@unique([exerciseId, date])
}

model ExerciseLog {
  id         String   @id @default(uuid())
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  setsDone   Int
  repsDone   Int
  date       DateTime
  createdAt  DateTime @default(now())
}

model Appointment {
  id             String          @id @default(uuid())
  recoveryPlanId String
  recoveryPlan   RecoveryPlan    @relation(fields: [recoveryPlanId], references: [id])
  title          String?
  date           DateTime
  provider       String
  notes          String?
  type           AppointmentType @default(MEDICAL)
  attended       Boolean?
  rescheduledFromDate DateTime?
  createdAt      DateTime        @default(now())
}

model Measurement {
  id             String          @id @default(uuid())
  recoveryPlanId String
  recoveryPlan   RecoveryPlan    @relation(fields: [recoveryPlanId], references: [id])
  type           MeasurementType
  customLabel    String?
  value          Float
  unit           String
  date           DateTime
  createdAt      DateTime        @default(now())
}

model ProgressPhoto {
  id             String       @id @default(uuid())
  recoveryPlanId String
  recoveryPlan   RecoveryPlan @relation(fields: [recoveryPlanId], references: [id])
  photoUrl       String
  date           DateTime
  createdAt      DateTime     @default(now())
}

model PainLog {
  id             String       @id @default(uuid())
  recoveryPlanId String
  recoveryPlan   RecoveryPlan @relation(fields: [recoveryPlanId], references: [id])
  date           DateTime     @db.Date
  level          Int
  note           String?
  createdAt      DateTime     @default(now())

  @@unique([recoveryPlanId, date])
}
