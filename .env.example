# Copia este archivo como .env y completa los valores reales.
# PORT es el puerto gRPC (main.ts lo usa como url: 0.0.0.0:${PORT}).
# api-gateway apunta por defecto a localhost:50053 (REHAB_GRPC_URL), no cambies
# este valor salvo que también actualices el .env de api-gateway.
PORT=50053
NATS_SERVERS="nats://localhost:4222"

# Mismo Postgres del docker-compose. Si en tu Mac usabas una DB separada
# "rehab_db", tenes que crearla a mano (el compose solo crea "auth_db").
DATABASE_URL="postgresql://lifetrack:devpass123@localhost:5432/auth_db?schema=rehab"
