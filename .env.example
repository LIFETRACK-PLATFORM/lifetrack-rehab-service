# Copia este archivo como .env y completa los valores reales.
# PORT es el puerto gRPC (main.ts lo usa como url: 0.0.0.0:${PORT}).
# api-gateway apunta por defecto a localhost:50053 (REHAB_GRPC_URL), no cambies
# este valor salvo que también actualices el .env de api-gateway.
PORT=50053
NATS_SERVERS="nats://localhost:4222"

# Usa una base de datos propia, NO auth_db: el datasource de este servicio
# (prisma/schema.prisma) no tiene habilitado el feature "multiSchema" de
# Prisma, así que un query param `?schema=xxx` se ignora por completo y las
# tablas terminarían creándose en el schema "public" de auth_db, mezcladas
# con las de auth-service. Crea la base a mano si el compose no la crea:
# docker exec -it <contenedor-postgres> psql -U lifetrack -c 'CREATE DATABASE rehab_db;'
DATABASE_URL="postgresql://lifetrack:devpass123@localhost:5432/rehab_db"
